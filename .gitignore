# STM32CubeIDE / Eclipse local workspace state
.metadata/
.recommenders/
RemoteSystemsTempFiles/

# Generated firmware build directories (regenerated by CubeIDE)
/firmware/*/Debug/
/firmware/*/Release/

# Compiled firmware and native test outputs
*.o
*.obj
*.d
*.su
*.cyclo
*.elf
*.axf
*.hex
*.bin
*.map
*.list
*.lst
*.exe
/tests/host/build/

# Local debugger launch configurations
*.launch

# Python caches and local virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Generated firmware packages; retain JSON measurement evidence
/artifacts/*.fwp

# Editor backup and operating-system files
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Intentionally retain .ioc, .project, .cproject, .settings/, linker scripts,
# startup code, HAL/CMSIS sources, documentation, and measurement JSON files.
